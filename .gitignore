# ESP-IDF
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/.idf_component_manager/
firmware/.cache/

# Generated per-profile build trees and configurations
/firmware/build-*/
/firmware/sdkconfig.*
!/firmware/sdkconfig.defaults

# Bench captures and flash backups must survive idf.py fullclean / set-target.
/.local/bench/

# Ephemeral review and commit preparation
/.local/review/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak

# Python bytecode cache directories
__pycache__/

# FreeCAD automatic backups; keep the primary .FCStd models
/hardware/**/*.FCStd[0-9]*
/hardware/**/*.FCBak

# Local temporary files
/tmp/

# Project worktrees
/.worktrees/
