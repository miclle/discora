"""Reopen the saved three-part PLA model and validate static B-rep geometry."""
import hashlib
import json
import math
import os
from pathlib import Path
import FreeCAD as A
import Part
from PySide import QtWidgets


def validate(folder):
    model=folder/'Discora.FCStd';doc=A.openDocument(str(model))
    objects=[o for g in ('Shell','Controls','Carrier','Hardware') for o in doc.getObject(g).Group]
    tolerance=.001
    invalid=[o.Name for o in objects if o.Shape.isNull() or not o.Shape.isValid() or not o.Shape.Solids]
    assert not invalid,invalid
    def collisions(shape,candidates):
        hits=[];a=shape.BoundBox
        for o in candidates:
            b=o.Shape.BoundBox
            if any(min(getattr(a,k+'Max'),getattr(b,k+'Max'))-max(getattr(a,k+'Min'),getattr(b,k+'Min'))<1e-7 for k in 'XYZ'):continue
            volume=shape.common(o.Shape).Volume
            if volume>tolerance:hits.append({'object':o.Name,'volume_mm3':volume})
        return hits
    clashes=[]
    for i,o in enumerate(objects):
        for hit in collisions(o.Shape,objects[i+1:]):clashes.append({'first':o.Name,**hit})
    print('STATIC_CLASHES',clashes,flush=True)
    main=['FrontShell','RearShell','SpeakerCarrier']
    connected={n:len(doc.getObject(n).Shape.Solids) for n in main}
    assert all(n==1 for n in connected.values()),connected
    roof_ownership={}
    for name in ('RearRoof','SlotGuide'):
        source=doc.getObject(name).Shape.cut(doc.RearFastenerCuts.Shape)
        roof_ownership[name]={'intersection_with_front_mm3':source.common(doc.FrontShell.Shape).Volume,
                              'missing_from_rear_mm3':source.cut(doc.RearShell.Shape).Volume}
        assert name in doc.RearShell.ConstructionObjects and name not in doc.FrontShell.ConstructionObjects
        assert all(abs(v)<=tolerance for v in roof_ownership[name].values()),roof_ownership
    assert abs(doc.FrontShell.Shape.BoundBox.YMax-42.5)<1e-7
    # Read the actual side seam endpoints from the retained section and handle.
    seam_start=doc.FoldSection.Geometry[10].StartPoint
    seam_end=doc.FoldSection.Geometry[5].StartPoint
    seam_points=[]
    for x in (-70,70):
        for y in (6,12,24,35,38,40,42.4):
            z=seam_start.y+(y-seam_start.x)*(seam_end.y-seam_start.y)/(seam_end.x-seam_start.x)
            assert doc.FrontShell.Shape.isInside(A.Vector(x,y,z+.05),1e-6,True)
            assert doc.RearShell.Shape.isInside(A.Vector(x,y,z-.05),1e-6,True)
            seam_points.append([x,y,z])
    # Measure thickness on the saved solid, along each panel's normal.
    slope=27/38;normal=A.Vector(0,-slope,1);normal.normalize()
    thickness={}
    def section_length(name,point,axis):
        probe=Part.makeLine(point-axis*10,point+axis*10)
        return sum(edge.Length for edge in doc.getObject(name).Shape.common(probe).Edges)
    for x,z in [(-60,150),(60,150),(-67,80),(67,80),(0,6)]:
        thickness[f'vertical_{x}_{z}']=section_length('FrontShell',A.Vector(x,0,z),A.Vector(0,1,0))
    # Keep panel probes outside the two added blind mounting posts at X=±29.
    for x,y in [(-30,8),(30,8),(-25,30),(25,30),(50,32)]:
        thickness[f'slope_{x}_{y}']=section_length('FrontShell',A.Vector(x,y,165+slope*y),normal)
    thickness['grille']=section_length('FrontGrille',A.Vector(1.45,0,76),A.Vector(0,1,0))
    thickness['handle']=section_length('FrontShell',A.Vector(60,40,206),A.Vector(0,1,0))
    assert all(abs(value-(2.5 if name=='grille' else 5))<1e-6 for name,value in thickness.items()),thickness
    print('PANEL_THICKNESS',thickness,flush=True)
    # Check the finished front shell, not just its hidden circular cutter.
    mouth=Part.makeCylinder(65,2.5-2e-5,A.Vector(0,1e-5,76),A.Vector(0,1,0))
    mouth_obstruction=doc.FrontShell.Shape.common(mouth).Volume
    circles=[e.Curve.Radius for e in doc.FrontShell.Shape.Edges
             if isinstance(e.Curve,Part.Circle)
             and (e.Curve.Center-A.Vector(0,0,76)).Length<1e-6
             and abs(e.Length-2*math.pi*65)<1e-5]
    recess=doc.FrontGrille.Shape.BoundBox.YMin
    grille_check={'opening_diameter_mm':130,'recess_mm':recess,
                  'grille_thickness_mm':doc.FrontGrille.Shape.BoundBox.YLength,
                  'mouth_obstruction_mm3':mouth_obstruction,
                  'complete_front_circle_radii_mm':circles,
                  'grille_back_y_mm':doc.FrontGrille.Shape.BoundBox.YMax,
                  'driver_front_gap_mm':doc.LDriver.Shape.BoundBox.YMin-doc.FrontGrille.Shape.BoundBox.YMax}
    assert circles and all(abs(r-65)<1e-6 for r in circles),grille_check
    assert mouth_obstruction<=tolerance and abs(recess-2.5)<1e-6,grille_check
    assert abs(grille_check['grille_back_y_mm']-5)<1e-6 and abs(grille_check['driver_front_gap_mm']-3)<1e-6,grille_check
    # The larger sheet is masked by the smaller panel opening. Read the final
    # hole walls to distinguish complete circles from exposed circular segments.
    hole_walls=[f for f in doc.FrontShell.Shape.Faces
                if isinstance(f.Surface,Part.Cylinder) and abs(f.Surface.Radius-.94)<1e-6]
    areas={}
    for face in hole_walls:
        key=(round(face.Surface.Center.x,6),round(face.Surface.Center.z-76,6))
        areas[key]=areas.get(key,0)+face.Area
        assert abs(face.BoundBox.YMin-2.5)<1e-6 and abs(face.BoundBox.YMax-5)<1e-6
    centers=set(areas)
    source_centers={(round((col+.5*(row%2))*2.9,6),round(row*2.9,6))
                    for row in range(-24,25) for col in range(-24,25)
                    if math.hypot((col+.5*(row%2))*2.9,row*2.9)+.94<=67}
    expected={p for p in source_centers if math.hypot(*p)-.94<65}
    full={p for p in expected if math.hypot(*p)+.94<=65}
    partial=expected-full
    assert centers==expected and len(full)==1531 and len(partial)==92,(len(centers),len(full),len(partial))
    full_wall_area=2*math.pi*.94*2.5
    assert all(abs(areas[p]-full_wall_area)<1e-5 for p in full)
    assert all(0<areas[p]<full_wall_area-1e-5 for p in partial)
    assert all((-x,z) in centers for x,z in centers)
    source_walls=[f for f in doc.FrontGrille.Shape.Faces
                  if isinstance(f.Surface,Part.Cylinder) and abs(f.Surface.Radius-.94)<1e-6]
    assert len(source_walls)==1627 and abs(doc.FrontGrille.Shape.BoundBox.XLength-136)<1e-6
    grille_check.update(sheet_diameter_mm=136,panel_underlap_mm=3,source_hole_count=len(source_walls),
                        exposed_hole_count=len(centers),complete_exposed_holes=len(full),
                        partially_masked_edge_holes=len(partial),fully_masked_holes=len(source_centers-expected),
                        continuous_visible_rim=False,minimum_hole_web_mm=2.9-1.88)
    print('RECESSED_GRILLE',grille_check,flush=True)
    mirror=A.Matrix();mirror.A11=-1
    def reflected(shape):
        s=shape.copy();s.transformShape(mirror,True);return s
    def difference(a,b):return a.cut(b).Volume+b.cut(a).Volume
    symmetry={}
    for left,right in [('LPort','RPort'),('LDriver','RDriver'),('LChamber','RChamber'),('LDriverFrame','RDriverFrame'),('Window','Window')]:
        symmetry[left+' / '+right]=difference(reflected(doc.getObject(left).Shape),doc.getObject(right).Shape)
    rear=doc.RearShell.Shape
    exceptions=doc.DACPads.Shape.fuse(reflected(doc.DACPads.Shape))
    symmetry['RearShell (internal DAC pads excepted)']=difference(rear.cut(exceptions),reflected(rear).cut(exceptions))
    # The lower speaker structure, including baffle and mounting tabs, is symmetric.
    low=doc.SpeakerCarrier.Shape.common(Part.makeBox(300,200,220.5,A.Vector(-150,-50,-100)))
    symmetry['SpeakerCarrier below Z=120.5']=difference(low,reflected(low))
    exceptions=doc.CowlTool.Shape.multiFuse([reflected(doc.CowlTool.Shape),doc.ButtonMounts.Shape,reflected(doc.ButtonMounts.Shape)])
    front=doc.FrontShell.Shape
    symmetry['FrontShell (control cutouts and button mounts excepted)']=difference(front.cut(exceptions),reflected(front).cut(exceptions))
    print('SYMMETRY',symmetry,flush=True)
    links={n:(doc.getObject(n).TypeId=='Part::Mirroring' and doc.getObject(n).Source.Name==n.replace('R','L',1)) for n in ('RPort','RDriver','RChamber','RDriverFrame')}
    slot_y=doc.Drive.Shape.BoundBox.Center.y
    sweep=Part.makeBox(120,1.2,300,A.Vector(-60,slot_y-.6,doc.Drive.Shape.BoundBox.ZMin+2))
    disc=collisions(sweep,objects)
    # Read alignment from saved geometry, independently of build parameters.
    handle_y=(doc.FoldSection.Geometry[2].StartPoint.x+doc.FoldSection.Geometry[4].StartPoint.x)/2
    shoulders={}
    for name,index in [('front',1),('rear',5)]:
        edge=doc.FoldSection.Geometry[index]
        run=abs(edge.EndPoint.x-edge.StartPoint.x)
        rise=abs(edge.EndPoint.y-edge.StartPoint.y)
        shoulders[name]={'horizontal_width_mm':run,'rise_mm':rise,
                         'surface_width_mm':math.hypot(run,rise),
                         'angle_deg':math.degrees(math.atan2(rise,run))}
    assert all(abs(shoulders['front'][k]-shoulders['rear'][k])<1e-7 for k in shoulders['front']),shoulders
    shoulder_z=doc.FoldSection.Geometry[2].StartPoint.y
    handle_top=doc.FoldSection.Geometry[3].StartPoint.y
    port_alignment={'handle_center_y_mm':handle_y,
        'port_center_y_mm':{n:doc.getObject(n).Shape.BoundBox.Center.y for n in ('LPort','RPort')},
        'shell_opening_center_y_mm':doc.LPanelTool.Shape.BoundBox.Center.y}
    paths={}
    for side,sign in [('L',-1),('R',1)]:
        # Pass behind the driver frame, then turn before entering the shifted tube.
        air_y=doc.LPort.Shape.BoundBox.Center.y+8
        points=[(sign*26,54,76),(sign*56,54,76),(sign*56,air_y,76),
                (sign*56,air_y,95),(sign*73,air_y,95)]
        parts=[]
        for a,b in zip(points,points[1:]):
            a,b=A.Vector(*a),A.Vector(*b);parts.append(Part.makeCylinder(.4,(b-a).Length,a,b-a))
        paths[side]={'points_mm':points,'probe_radius_mm':.4,'clashes':collisions(Part.makeCompound(parts),objects)}
    reservations=[
        ('amp_input',(-48,6,123),(15,53,16.6),('Amp','AmpChip','SpeakerCarrier')),
        ('amp_output',(33,6,123),(15,53,16.6),('Amp','AmpChip','SpeakerCarrier')),
        ('mcu_left',(-36.695,33.56,148.7),(5,27.94,8.6),('MCU','MCUChip','SpeakerCarrier')),
        ('mcu_right',(31.695,33.56,148.7),(5,27.94,8.6),('MCU','MCUChip','SpeakerCarrier')),
        ('dac_input',(-67,33,122),(8.6,17,5),('DAC','DACChip','RearShell')),
        ('dac_output',(-67,33,158),(8.6,17,10),('DAC','DACChip','RearShell'))]
    keepouts={}
    # Check support structures too, excluding only the original pad solids from
    # their owners. A whole integrated carrier must not hide connector conflicts.
    support_free={
        'SpeakerCarrier':doc.SpeakerCarrier.Shape.cut(doc.AmpPads.Shape).cut(doc.MCUPads.Shape),
        'RearShell':doc.RearShell.Shape.cut(doc.DACPads.Shape)}
    for name,origin,size,owners in reservations:
        shape=Part.makeBox(*size,A.Vector(*origin))
        hits=collisions(shape,[o for o in objects if o.Name not in owners])
        for owner in owners:
            if owner in support_free:
                volume=shape.common(support_free[owner]).Volume
                if volume>tolerance:hits.append({'object':owner,'volume_mm3':volume})
        keepouts[name]={'origin_mm':origin,'size_mm':size,'clashes':hits}
    harness=Part.makeCylinder(1,12,A.Vector(50,30,136),A.Vector(0,0,1))
    keepouts['volume_harness']={'radius_mm':1,'origin_mm':[50,30,136],'height_mm':12,'clashes':collisions(harness,objects)}
    clearances={}
    for a,b in [('Battery','FrontShell'),('Battery','SpeakerCarrier'),('MCUChip','FrontShell'),('Bridge','DAC'),('Drive','MCUChip')]:
        clearances[a+' / '+b]=doc.getObject(a).Shape.distToShape(doc.getObject(b).Shape)[0]
    battery=doc.Battery.Shape.BoundBox
    battery_fit={'supplier_size_xyz_mm':[112,70,20],'model_size_xyz_mm':[battery.XLength,battery.YLength,battery.ZLength],
                 'origin_xyz_mm':[battery.XMin,battery.YMin,battery.ZMin],
                 'front_inner_wall_gap_mm':battery.YMin-5,'rear_inner_wall_gap_mm':77-battery.YMax,
                 'cradle_side_gap_mm':1,'lead_and_connector_envelope_verified':False,'retention_verified':False}
    controls={};baseline_path=os.environ.get('DISCORA_CAD_BASELINE')
    if baseline_path:
        baseline=A.openDocument(baseline_path)
        for n in ('Window','StatusArt','Knob','DisplayPCB','DisplayHeader','DisplayCarrier'):
            previous=baseline.getObject(n).Shape.copy()
            previous.translate(A.Vector(0,0,15))
            controls[n]=difference(previous,doc.getObject(n).Shape)
        controls['source_model_sha256']=hashlib.sha256(Path(baseline_path).read_bytes()).hexdigest()
        A.closeDocument(baseline.Name)
    bb=Part.makeCompound([o.Shape for o in objects]).BoundBox
    handle=collisions(Part.makeBox(70,10,14,A.Vector(-35,handle_y-5,shoulder_z+5.5)),objects)
    report={'date':'2026-11-10','model':model.name,'sha256':hashlib.sha256(model.read_bytes()).hexdigest(),
        'version':A.Version()[:3],'items':len(objects),'objects':[o.Name for o in objects],
        'main_pla_parts':connected,'rigid_pla_pieces':['FrontShell','RearShell','SpeakerCarrier','PlayPauseKey','EjectKey','PrevKey','NextKey','ButtonRetainer','DisplayRetainer','Knob'],
        'rear_roof_ownership':roof_ownership,'shell_split_y_mm':42.5,
        'straight_side_seam_yz_mm':[[seam_start.x,seam_start.y],[seam_end.x,seam_end.y]],
        'side_seam_ownership_samples_xyz_mm':seam_points,
        'invalid':invalid,'intersection_tolerance_mm3':tolerance,'clashes':clashes,
        'assembly_size_xyz_mm':[bb.XLength,bb.YLength,bb.ZLength],
        'mirror_plane':'X=0','mirror_difference_mm3':symmetry,'native_mirror_links':links,
        'disc':disc,'disc_sweep_mm':{'origin':[-60,slot_y-.6,34],'size':[120,1.2,300]},
        'side_port_handle_alignment':port_alignment,'side_air_paths':paths,'connector_allowances':keepouts,'key_clearances_mm':clearances,
        'battery_fit':battery_fit,'controls_translation_xyz_mm':[0,0,15],
        'top_shoulders':shoulders,'front_panel_thickness_samples_mm':thickness,
        'recessed_grille':grille_check,
        'original_controls_difference_mm3':controls,'handle_opening_mm':[90,16],'handle_passage_clashes':handle,
        'physical_validation':False,'acoustic_tuning_verified':False,
        'limits':['Speaker mounting plane, actual mounting holes, terminals, gaskets and excursion remain unmeasured.',
                  'PCB sizes are documented; component heights and connector reservations are provisional.',
                  'Three main PLA solids and nominal screw/pilot bores do not validate printed strength or screw fit.',
                  'Separate assembly-path report distinguishes continuous conservative sweeps from sampled cover motion.',
                  'Battery leads, straps, connectors, bridge cables and power modules are not validated.',
                  'Side passages remain untuned; geometric continuity is not acoustic validation.']}
    (folder/'validation.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n')
    assert abs(handle_y-40)<1e-7
    assert all(abs(y-handle_y)<1e-7 for y in port_alignment['port_center_y_mm'].values())
    assert abs(port_alignment['shell_opening_center_y_mm']-handle_y)<1e-7
    assert len(objects)==32,len(objects)
    assert not clashes and not disc and not handle,(clashes,disc,handle)
    assert all(v<=tolerance for v in symmetry.values()),symmetry
    assert all(links.values()),links
    assert all(not p['clashes'] for p in paths.values()),paths
    assert all(not p['clashes'] for p in keepouts.values()),keepouts
    assert all(v>=1-1e-7 for v in clearances.values()),clearances
    assert abs(handle_top-(165+37.5*27/38+25))<1e-7
    assert all(abs(a-b)<1e-7 for a,b in zip(report['assembly_size_xyz_mm'],[142,80,handle_top]))
    assert all(abs(a-b)<1e-7 for a,b in zip(battery_fit['model_size_xyz_mm'],[112,70,20]))
    assert all(v<=tolerance for k,v in controls.items() if k!='source_model_sha256'),controls
    print('PASS: three connected PLA solids, interference, symmetry, disc and air paths',flush=True)
    return doc


target=os.environ.get('DISCORA_CAD_OUTPUT') or QtWidgets.QFileDialog.getExistingDirectory(None,'选择 Discora 模型目录进行验证')
if target:validate(Path(target))
