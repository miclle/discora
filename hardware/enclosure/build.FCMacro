"""Build the editable Discora V4 top-loading concept in FreeCAD. Units: mm."""
import os
import math
from pathlib import Path

import FreeCAD as A
import FreeCADGui as G
import Part
import Sketcher
from PySide import QtCore, QtWidgets

V = A.Vector
X, Y, Z = V(1, 0, 0), V(0, 1, 0), V(0, 0, 1)
# P1: Bambu PLA Lite Orange 16301, #FF671F (Bambu Studio filament color table).
ORANGE, TEAL, BLACK, RUBBER = (1.0, 0.403921568627451, 0.12156862745098039), (0.025, 0.75, 0.72), (0.145, 0.155, 0.17), (0.07, 0.08, 0.09)
GLASS, PIXEL = (0.045, 0.085, 0.10), (0.85, 0.97, 1.0)
# Knob: Bambu PLA Basic Black 10101; white is the PLA Lite symbol region.
KNOB_BLACK, WHITE, SILVER, PCB, BLUE = (0.0, 0.0, 0.0), (1.0, 1.0, 1.0), (0.70, 0.73, 0.75), (0.14, 0.40, 0.32), (0.12, 0.33, 0.62)
# The drive face is parallel to XZ and the disc moves vertically behind the handle.
WIDTH = 142.0
DRIVE = (128.0, 9.5, 129.0)
# User-supplied total envelope, oriented upright: depth, width, height.
# Frontmost diaphragm to rearmost magnet; mounting plane remains unmeasured.
SPEAKER = (42.0, 45.0, 80.0)
CASE_DEPTH = 80.0
# Equal front/rear shoulders retain the original front angle and drive clearance.
HANDLE_THICKNESS = 5.0
FRONT_THICKNESS = HANDLE_THICKNESS
REAR_THICKNESS = 3.0
# Move internal hardware back by the added front wall thickness.
INTERNAL_SHIFT_Y = FRONT_THICKNESS - 3.0
SHOULDER_RUN = (CASE_DEPTH - HANDLE_THICKNESS) / 2
SHOULDER_SLOPE = 27.0 / 38.0
EAVE_Z = 165.0
SHOULDER_Z = EAVE_Z + SHOULDER_RUN * SHOULDER_SLOPE
HANDLE_FRONT, HANDLE_REAR = SHOULDER_RUN, CASE_DEPTH - SHOULDER_RUN
HANDLE_TOP = SHOULDER_Z + 25.0
ROOF_OFFSET_Z = REAR_THICKNESS * math.sqrt(1 + SHOULDER_SLOPE**2)
FRONT_OFFSET_Z = FRONT_THICKNESS * math.sqrt(1 + SHOULDER_SLOPE**2)
INNER_CENTER_Y = CASE_DEPTH/2 + (FRONT_OFFSET_Z-ROOF_OFFSET_Z)/(2*SHOULDER_SLOPE)
INNER_FRONT, INNER_REAR = INNER_CENTER_Y-1.25, INNER_CENTER_Y+1.25
INNER_PEAK_Z = EAVE_Z + INNER_FRONT * SHOULDER_SLOPE - FRONT_OFFSET_Z
FRONT_INNER_EAVE_Z = EAVE_Z + FRONT_THICKNESS * SHOULDER_SLOPE - FRONT_OFFSET_Z
INNER_EAVE_Z = EAVE_Z + REAR_THICKNESS * SHOULDER_SLOPE - ROOF_OFFSET_Z
# Two front-facing drivers share one circular grille, but separate rear cavities.
SPEAKER_CENTER_X, SPEAKER_CENTER_Z = 26.0, 76.0
# Align the side-view vertical port axis with the centered handle mid-plane.
PORT_CENTER_Y, PORT_CENTER_Z = CASE_DEPTH / 2, 80.0
FRONT_GRILLE_RADIUS = 65.0
# A true circular mouth precedes the grille; +Y is inward from the front face.
FRONT_GRILLE_RECESS = 2.5
GRILLE_HOLE_RADIUS, GRILLE_PITCH = .94, 2.9
GRILLE_UNDERLAP = 3.0
# Supplier image: selected flat 5600 mAh pack, excluding leads/connectors.
BATTERY = (112.0, 70.0, 20.0)
SLOT_Y = 65.75 + INTERNAL_SHIFT_Y
DRIVE_TOP = 161.0
# OLED supplier drawing: dimensions are nominal, not measured hardware.
# The origin is the active-area center; +Z points toward the four-pin header.
DISPLAY_WINDOW = (30.42, 15.7)  # 0.5 mm beyond the active area on each side
DISPLAY_OUTER_WINDOW = (32.82, 18.1)  # flared mouth; throat starts 0.8 mm inward
DISPLAY_DECK_Y = 18.0
DISPLAY_PCB = (35.4, 1.2, 33.5)
DISPLAY_HOLES = [(x,z) for x in (-15.2,15.2) for z in (-16.3,12.2)]


def oled_shapes():
    """Local geometry from oled-module-dimensions-wiring.webp, in mm.

    Panel front is 1.0 behind the exterior; a rear pocket leaves a 0.8 lip.
    Four pegs locate the PCB, and a removable frame bears only on hole lands.
    The side-view 11.3 spans
    panel front to bent-pin tip. Header width/thickness are conservative
    reservations (4 pitches by 1 pitch), not measured housing dimensions.
    """
    pcb=Part.makeBox(*DISPLAY_PCB,V(-17.7,2.4,-18.8))
    pcb=pcb.cut(Part.makeBox(14,2,4.01,V(-7,2,-18.81)))
    for x,z in DISPLAY_HOLES:
        pcb=pcb.cut(Part.makeCylinder(1.5,2,V(x,2,z),Y))
    panel=Part.makeBox(34.5,1.4,23,V(-17.25,1,-13.55))
    header=Part.makeBox(10.16,8.7,2.54,V(-5.08,3.6,11.43))
    left=Part.makeCompound([Part.makeCylinder(2.25,.6,V(-15.2,1.8,z),Y).fuse(
        Part.makeCylinder(1.3,1.6,V(-15.2,2.4,z),Y)) for z in (-16.3,12.2)]+
        [Part.makeCylinder(2.5,2.9,V(-20.5,3.5,-7),Y)])
    pilots=Part.makeCompound([Part.makeCylinder(.8,4.5,V(x,2,-7),Y) for x in (-20.5,20.5)])
    pocket=Part.makeBox(34.9,12,23.4,V(-17.45,.8,-13.75)).fuse(
        Part.makeBox(36,12,34.1,V(-18,2.2,-19.1)))
    # Open-bottom U frame leaves the header, PCB centre and lower notch accessible.
    frame=Part.makeBox(44.5,2,3.5,V(-22.25,6.4,15.7))
    members=[]
    for sign in (-1,1):
        cx=sign*20.5
        members.append(Part.makeBox(3.5,2,34.25,V(cx-1.75,6.4,-18.55)))
        members.append(Part.makeCylinder(3,2,V(cx,6.4,-7),Y))
        for z in (-16.3,12.2):
            x=sign*15.2
            members.append(Part.makeCylinder(2.25,4.8,V(x,3.6,z),Y))
            members.append(Part.makeBox(5.3,2,3.5,V(min(x,cx),6.4,z-1.75)))
    frame=frame.multiFuse(members)
    for x,z in DISPLAY_HOLES:
        frame=frame.cut(Part.makeCylinder(1.6,5,V(x,3.5,z),Y))
    for x in (-20.5,20.5):
        frame=frame.cut(Part.makeCylinder(1.1,2.2,V(x,6.3,-7),Y))
    return pcb.removeSplitter(),panel,header,left,pilots,frame.removeSplitter(),pocket.removeSplitter()
# Centers on the exterior slope; front row then rear row.
BUTTONS = [('PlayPause', '播放／暂停', -59.0, 9.0),
           ('Eject', '退碟', -41.0, 9.0),
           ('Prev', '上一曲', -59.0, 26.0),
           ('Next', '下一曲', -41.0, 26.0)]


def button_retainer(row_offset):
    """Open direct-wire support; switch terminal pairs face local +/-Z.

    Two pads per switch bear away from its central molded details. Continuous
    terminal-side openings avoid inventing an unmeasured four-pin footprint.
    """
    def block(x,y,z,w,d,h):
        return Part.makeBox(w,d,h,V(x,y,z))
    frame=block(-1.5,16.5,-row_offset-1.5,3,2,2*row_offset+3)
    frame=frame.fuse(block(-17,16.5,-2.4,34,2,4.8))
    for rz in (-row_offset,row_offset):
        frame=frame.fuse(block(-15,16.5,rz-1.5,30,2,3))
        for cx in (-9,9):
            for dx in (-3.8,3.8):
                frame=frame.fuse(block(cx+dx-1,12,rz-1.5,2,4.5,3))
    for x in (-14,14):
        frame=frame.cut(Part.makeCylinder(1.1,2.3,V(x,16.4,0),Y))
        frame=frame.cut(Part.makeCone(2.1,1.1,1,V(x,18.5,0),-Y))
    return frame.removeSplitter()


def button_parts(key):
    """Return orange body and white symbol solids in the key-local frame."""
    def box(x,y,z,dx,dy,dz):
        return Part.makeBox(dx,dy,dz,V(x,y,z))
    cap=Part.makeCylinder(5,7.2,V(0,-1.2,0),Y).fuse(Part.makeCylinder(6.4,.8,V(0,5.2,0),Y))
    # A 0.6 mm flush white region is printed with the orange body.
    symbols=[]
    def triangle(points):
        pts=[V(xx,-1.2,zz) for xx,zz in points]
        symbols.append(Part.Face(Part.makePolygon(pts+pts[:1])).extrude(Y*.6))
    if key=='PlayPause':
        triangle([(-2.9,-2),(-2.9,2),(0,0)])
        symbols += [box(.7,-1.2,-2,.8,.6,4),box(2.1,-1.2,-2,.8,.6,4)]
    elif key=='Eject':
        triangle([(-2.7,-.2),(2.7,-.2),(0,2.7)])
        symbols.append(box(-2.7,-1.2,-2.1,5.4,.6,.8))
    else:
        sign=-1 if key=='Prev' else 1
        triangle([(-sign*2,-2),(-sign*2,2),(sign*1.8,0)])
        symbols.append(box(-3 if key=='Prev' else 2.2,-1.2,-2,.8,.6,4))
    marks=Part.makeCompound(symbols)
    body=cap.cut(marks).removeSplitter()
    return body,marks


def build(folder):
    doc = A.newDocument("DiscoraV4Topload")
    doc.Label = "Discora V4 · 三件主要 PLA 结构"
    visible = []

    def group(name, label):
        obj = doc.addObject("App::DocumentObjectGroup", name)
        obj.Label = label
        return obj

    shell = group("Shell", "01 · PLA 外壳")
    ui = group("Controls", "02 · 状态屏和操控件")
    supports = group("Carrier", "03 · PLA 内部支架")
    hardware = group("Hardware", "04 · 硬件占位（待实测）")

    def finish(obj, name, color, parent):
        obj.Label = name
        parent.addObject(obj)
        obj.ViewObject.ShapeColor = color
        obj.ViewObject.DisplayMode = "Shaded"
        visible.append(obj)
        return obj

    def feature(key, label, shape, color, parent):
        obj = doc.addObject("Part::Feature", key)
        obj.Shape = shape
        return finish(obj, label, color, parent)

    def mirrored(key, label, source, color, parent):
        obj = doc.addObject("Part::Mirroring", key)
        obj.Source = source
        obj.Base, obj.Normal = V(0,0,0), X
        return finish(obj, label, color, parent)

    def prism_yz(points, x, width):
        pts = [V(x, y, z) for y, z in points]
        return Part.Face(Part.makePolygon(pts + pts[:1])).extrude(X * width)

    def cylinder(radius, height, origin, axis):
        return Part.makeCylinder(radius, height, V(*origin), axis)

    def box(x, y, z, dx, dy, dz):
        return Part.makeBox(dx, dy, dz, V(x, y, z))

    def block(key, label, origin, dims, color, parent):
        obj = doc.addObject("Part::Box", key)
        obj.Length, obj.Width, obj.Height = dims
        obj.Placement = A.Placement(V(*origin), A.Rotation())
        return finish(obj, label, color, parent)

    def obround(origin, along, across, normal, length, width, thickness):
        c = V(*origin)
        r = width / 2
        a, b = c - along * (length / 2 - r), c + along * (length / 2 - r)
        edges = [Part.makeLine(a + across*r, b + across*r),
                 Part.Arc(b + across*r, b + along*r, b - across*r).toShape(),
                 Part.makeLine(b - across*r, a - across*r),
                 Part.Arc(a - across*r, a - along*r, a + across*r).toShape()]
        return Part.Face(Part.Wire(edges)).extrude(normal * thickness)

    def display_rect(width, height, radius, y, depth):
        z = 0.0
        rect = box(-width/2+radius,y,z-height/2,width-2*radius,depth,height)
        rect = rect.fuse(box(-width/2,y,z-height/2+radius,width,depth,height-2*radius))
        corners = [cylinder(radius,depth,(x,y,zz),Y)
                   for x in (-width/2+radius,width/2-radius)
                   for zz in (z-height/2+radius,z+height/2-radius)]
        return rect.multiFuse(corners).removeSplitter()

    def side_capsule(x, y, z, length, width, depth):
        return obround((x, y, z), Z, Y, X, length, width, depth)

    def native_cut(key, label, base, tool, color, parent):
        cutter = doc.addObject("Part::Feature", key + "Tool")
        cutter.Shape = tool
        cutter.Label = label + " · 刀体"
        obj = doc.addObject("Part::Cut", key)
        obj.Base, obj.Tool = base, cutter
        base.Visibility = cutter.Visibility = False
        return finish(obj, label, color, parent)

    def raw(key, shape):
        obj = doc.addObject("Part::Feature", key)
        obj.Shape = shape
        return obj

    # An editable sketch drives the continuous front, roof and handle extrusion.
    profile = [(0,3),(0,EAVE_Z),(HANDLE_FRONT,SHOULDER_Z),(HANDLE_FRONT,HANDLE_TOP),
               (HANDLE_REAR,HANDLE_TOP),(HANDLE_REAR,SHOULDER_Z),(CASE_DEPTH,EAVE_Z),
               (CASE_DEPTH-3,INNER_EAVE_Z),(INNER_REAR,INNER_PEAK_Z),
               (INNER_FRONT,INNER_PEAK_Z),(FRONT_THICKNESS,FRONT_INNER_EAVE_Z),(FRONT_THICKNESS,3)]
    section = doc.addObject("Sketcher::SketchObject", "FoldSection")
    section.Label = "壳体 YZ 截面 · 可编辑"
    section.Placement = A.Placement(V(-WIDTH/2,0,0), A.Rotation(V(1,1,1),120))
    for a,b in zip(profile, profile[1:] + profile[:1]):
        section.addGeometry(Part.LineSegment(V(*a,0),V(*b,0)),False)
    skin = doc.addObject("Part::Extrusion","FoldedSkin")
    skin.Base, skin.Dir, skin.Solid = section, X*WIDTH, True
    section.Visibility = False
    # Round top outer corners on the flange; preserve the crisp shoulder folds.
    doc.recompute()
    rounded = []
    for i, edge in enumerate(skin.Shape.Edges, 1):
        c = edge.CenterOfMass
        at_end = abs(abs(c.x)-WIDTH/2) < .01
        if at_end and abs(c.z-HANDLE_TOP) < .01:
            rounded.append((i, 4.0, 4.0))
        elif at_end and abs(c.y) < .01 and edge.Length > 140:
            rounded.append((i, 1.6, 1.6))
    fil = doc.addObject("Part::Fillet","CowlEdges")
    fil.Base, fil.Edges = skin, rounded
    skin.Visibility = False
    skin = fil
    normal = V(0,-SHOULDER_SLOPE,1)
    normal.normalize()
    def deck(x,y):
        return V(x,y,EAVE_Z+SHOULDER_SLOPE*y)
    # Local screen X is horizontal, +Z runs up the slope, +Y points into the case.
    display_pose=A.Placement(deck(0,DISPLAY_DECK_Y),A.Rotation(Y,normal*-1))
    def aperture_wire(width,height,radius,y):
        slab=display_rect(width,height,radius,y,.1)
        return next(f.OuterWire for f in slab.Faces
                    if f.BoundBox.YLength<1e-7 and abs(f.CenterOfMass.y-y)<1e-7)
    flare=Part.makeLoft([aperture_wire(*DISPLAY_OUTER_WINDOW,1.8,0),
                         aperture_wire(*DISPLAY_WINDOW,.6,.8)],True,True)
    screen_cut=display_rect(*DISPLAY_OUTER_WINDOW,1.8,-3,3).fuse(flare).fuse(
        display_rect(*DISPLAY_WINDOW,.6,.8,8.2)).removeSplitter()
    screen_cut.Placement=display_pose.multiply(screen_cut.Placement)
    holes = [obround((0,HANDLE_FRONT-2,SHOULDER_Z+12.5), X,Z,Y,90,16,10),
             screen_cut,
             cylinder(FRONT_GRILLE_RADIUS,9,(0,-3,SPEAKER_CENTER_Z),Y),
             obround((0,SLOT_Y,145),X,Y,Z,124,3.2,HANDLE_TOP-145)]
    # Keep symmetric openings separate from the asymmetric control cutouts.
    common_tool = raw("SymmetricCowlTool",Part.makeCompound(holes))
    common_tool.Label = "居中开孔 · 提手／显示窗／格栅／碟口"
    symmetric_cowl = doc.addObject("Part::Cut","SymmetricCowl")
    symmetric_cowl.Label = "对称壳体 · 含提手及居中开孔"
    symmetric_cowl.Base, symmetric_cowl.Tool = skin, common_tool
    skin.Visibility = common_tool.Visibility = False
    controls = [Part.makeCylinder(r,12,deck(x,y)-normal*7,normal)
                for x,y,r in [(x,y,5.25) for _,_,x,y in BUTTONS]+[(48,18,4.4)]]
    native_cut("Cowl","整片折壳构造源 · 对称主体＋原操控开孔",symmetric_cowl,
               Part.makeCompound(controls),TEAL,shell)

    # Integral side ports retain open peripheral air passages.
    panel_profile = [(FRONT_THICKNESS,3),(CASE_DEPTH-3,3),(CASE_DEPTH-3,INNER_EAVE_Z),
                     (INNER_REAR,INNER_PEAK_Z),(INNER_FRONT,INNER_PEAK_Z),(FRONT_THICKNESS,FRONT_INNER_EAVE_Z)]
    cy, cz = PORT_CENTER_Y, PORT_CENTER_Z
    x = -WIDTH/2
    base = raw("LPanelBlank",prism_yz(panel_profile,x,3))
    left_panel = native_cut("LPanel","左侧壳 · 镜像源",base,
                            side_capsule(x-1,cy,cz,74,29,5),BLACK,shell)
    mirrored("RPanel","右侧壳 · 关联镜像",left_panel,BLACK,shell)

    # Build the left port and cavity, then mirror them exactly for the right.
    left=-WIDTH/2
    # Overlap the panel opening by 0.3 mm instead of leaving an assembly seam.
    ring=side_capsule(left,cy,cz,74.6,29.6,3).cut(side_capsule(left-1,cy,cz,67,22,5))
    # Stop 0.3 mm outside the chamber wall so P3 can slide forward with P2 fixed.
    tube=side_capsule(left+2,cy,cz,67,22,3.7).cut(side_capsule(left+1,cy,cz,63,18,6))
    inset=side_capsule(left+1.5,cy,cz,56,12,2)
    # Four connections support both ends as well as the middle of the long inset.
    # All ribs stay behind the recessed face and outside the carrier's sweep.
    bridge=box(left+2,cy-11,cz-1.5,2,22,3)
    end_bridges=[box(left+2,cy-1.5,z,2,3,9) for z in (cz-34.5,cz+25.5)]
    port=ring.multiFuse([tube,inset,bridge]+end_bridges).removeSplitter()
    # Compact symmetric cavities retain the complete driver envelopes.
    outer=box(left+6,5,31.5,WIDTH/2-6,52,89)
    inner=box(left+8.5,4,34,WIDTH/2-10,50.5,84)
    cavity=outer.cut(inner).cut(side_capsule(left-1,cy,cz,67.6,22.6,13.2)).removeSplitter()
    left_port = feature("LPort","左侧 · 导音孔及饰片构造源（并入 P2）",port,BLACK,shell)
    mirrored("RPort","右侧 · 导音孔及饰片镜像源（并入 P2）",left_port,BLACK,shell)
    left_chamber = feature("LChamber","左声道 · 后腔及侧向通道（未调谐）",cavity,TEAL,supports)
    mirrored("RChamber","右声道 · 后腔关联镜像（未调谐）",left_chamber,TEAL,supports)

    # Front grille, baffle and two rectangular driver envelopes.
    zc=SPEAKER_CENTER_Z
    radius=FRONT_GRILLE_RADIUS
    mesh_radius=radius+GRILLE_UNDERLAP
    bezel=cylinder(mesh_radius+.25,FRONT_THICKNESS-FRONT_GRILLE_RECESS,
                   (0,FRONT_GRILLE_RECESS,zc),Y).cut(cylinder(mesh_radius-.1,7,(0,-.1,zc),Y))
    feature("FrontBezel","面板下方 · 隐藏护网连接环",bezel,TEAL,shell)
    grille=cylinder(mesh_radius,FRONT_THICKNESS-FRONT_GRILLE_RECESS,(0,FRONT_GRILLE_RECESS,zc),Y)
    vents=[]
    grid_extent = int(mesh_radius / GRILLE_PITCH) + 1
    for row in range(-grid_extent,grid_extent+1):
        dz=row*GRILLE_PITCH
        for col in range(-grid_extent,grid_extent+1):
            dx=(col+.5*(row%2))*GRILLE_PITCH
            # The oversized sheet continues under the panel. The circular cowl
            # masks perimeter holes naturally; its visible aperture has no lip.
            if math.hypot(dx,dz)+GRILLE_HOLE_RADIUS<=mesh_radius-1:
                vents.append(cylinder(GRILLE_HOLE_RADIUS,FRONT_THICKNESS+1,(dx,FRONT_GRILLE_RECESS-.1,zc+dz),Y))
    feature("FrontGrille","中央双喇叭 · 内凹 2.5 mm 通孔护网",grille.cut(Part.makeCompound(vents)),TEAL,shell)
    depth,width,height=SPEAKER
    apertures=[]
    for right in [False,True]:
        prefix,label=("R","右") if right else ("L","左")
        cx=SPEAKER_CENTER_X if right else -SPEAKER_CENTER_X
        sx,sz=cx-width/2,zc-height/2
        if not right:
            left_driver=block("LDriver","左声道 · 80×45×42 喇叭总包络",(sx,8,sz),(width,depth,height),RUBBER,hardware)
            frame=box(sx-2,5,sz-2,width+4,depth+5,height+4).cut(
                box(sx-.2,4.5,sz-.2,width+.4,depth+6,height+.4))
            left_frame=feature("LDriverFrame","左喇叭预留框 · 安装面与孔位待测",frame,TEAL,supports)
        else:
            mirrored("RDriver","右声道 · 喇叭包络关联镜像",left_driver,RUBBER,hardware)
            mirrored("RDriverFrame","右喇叭预留框 · 关联镜像",left_frame,TEAL,supports)
        apertures.append(box(sx-.2,4.5,sz-.2,width+.4,3,height+.4))
    baffle=box(-65,5,31.5,130,2,89).cut(Part.makeCompound(apertures))
    feature("FrontBaffle","双单元前障板",baffle,RUBBER,supports)

    # Narrow side gaps leave no room for full-height rear screw pillars.
    # Lower mounts flank the battery; upper mounts sit behind the drive.
    rear=prism_yz([(CASE_DEPTH-3,3),(CASE_DEPTH,3),(CASE_DEPTH,EAVE_Z),
                   (CASE_DEPTH-3,INNER_EAVE_Z)],-WIDTH/2,WIDTH)
    tray=box(-WIDTH/2+3,FRONT_THICKNESS,3,WIDTH-6,CASE_DEPTH-FRONT_THICKNESS-3,3)
    feature("Back","后壳后壁 · 构造源",rear,BLACK,shell)
    feature("Base","后壳底板 · 构造源",tray,BLACK,shell)
    feet=[cylinder(4,3,(x,y,0),Z) for x in (-55,55) for y in (11,CASE_DEPTH-11)]
    feature("Feet","四个脚垫",Part.makeCompound(feet),RUBBER,ui)

    oled_pcb,oled_panel,oled_header,oled_left,oled_pilots,oled_frame,oled_pocket=oled_shapes()
    feature("Window","OLED 玻璃面板 · 34.5×23×1.4",oled_panel,GLASS,ui)
    # Raised luminous shapes are a display-content mockup, not printable parts.
    glyphs=[]
    def segment(x,z,w,h):
        glyphs.append(box(x,.85,z,w,.15,h))
    def digit(x,z,active):
        segments={'a':(x+.5,z+7,3,.55),'g':(x+.5,z+3.5,3,.55),
                  'd':(x+.5,z,3,.55),'f':(x,z+4,.55,2.8),
                  'b':(x+3.5,z+4,.55,2.8),'e':(x,z+.7,.55,2.6),
                  'c':(x+3.5,z+.7,.55,2.6)}
        for name in active: segment(*segments[name])
    digit(-13,-2,'abcdef')
    digit(-7,-2,'abc')
    # Play icon, battery outline and volume bars.
    pts=[V(1,.85,-1),V(1,.85,5),V(5,.85,2)]
    glyphs.append(Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(Y*.15))
    bz=1
    battery=box(8,.85,bz,5,.15,3).cut(box(8.5,.8,bz+.5,4,.4,2))
    glyphs.extend([battery,box(13,.85,bz+1,.7,.15,1),box(9,.85,bz+.8,2.5,.15,1.4)])
    for i in range(8): segment(-13+i*3.4,-6,2.3,1.2)
    feature("StatusArt","显示内容示意 · 曲目 07 / 播放 / 电量 / 音量",Part.makeCompound(glyphs),PIXEL,ui)
    # Local +Y is depth below the exterior face. Separate caps bridge the
    # 5 mm panel; a measured 2.8 mm actuator alone cannot pass through it.
    button_mounts=[]
    button_pose=A.Placement(deck(-50,17.5),A.Rotation(Y,normal*-1))
    row_offset=8.5*math.sqrt(1+SHOULDER_SLOPE**2)
    retainer=button_retainer(row_offset)
    for key,label,x,y in BUTTONS:
        pose=A.Placement(deck(x,y),A.Rotation(Y,normal*-1))
        def placed(shape):
            shape.Placement=pose.multiply(shape.Placement)
            return shape
        body,marks=button_parts(key)
        shape=Part.makeCompound([body,marks])
        face_colors=[WHITE if any(face.isSame(mark) for mark in marks.Faces) else ORANGE
                     for face in shape.Faces]
        key_obj=feature(key+'Key',label+' · 双色键帽／白色功能标记',placed(shape),ORANGE,ui)
        # Shared interface faces occur only once in the compound's face list.
        key_obj.ViewObject.DiffuseColor=face_colors
        switch=box(-6,8.8,-6,12,3.2,12).fuse(cylinder(6,2.8,(0,6,0),Y)).removeSplitter()
        obj=feature(key+'Switch',label+' · 12×12×6；圆头 Ø12 保守包络',placed(switch),RUBBER,hardware)
        for prop,value in [('BodyThickness',3.2),('ActuatorHeight',2.8),('PinLengthAllowance',3.7)]:
            obj.addProperty('App::PropertyLength',prop,'Switch dimensions');setattr(obj,prop,value)
        obj.addProperty('App::PropertyString','Unverified','Switch dimensions')
        obj.Unverified='Actuator diameter, stroke, pin footprint and support contact require measurement; pins are not modeled.'
        socket=box(-7.8,4.7,-7.8,15.6,7.5,15.6)
        socket=socket.cut(cylinder(6.6,3.9,(0,4.6,0),Y))
        socket=socket.cut(cylinder(6.2,.4,(0,8.5,0),Y))
        socket=socket.cut(box(-6.2,8.8,-6.2,12.4,3.5,12.4))
        button_mounts.append(placed(socket.removeSplitter()))
    for x in (-14,14):
        boss=cylinder(2.3,11.8,(x,4.7,0),Y).cut(cylinder(.8,10,(x,7,0),Y))
        boss.Placement=button_pose.multiply(boss.Placement);button_mounts.append(boss)
    retainer.Placement=button_pose.multiply(retainer.Placement)
    # Preserve the existing DAC connector allowance, with 0.5 mm side clearance.
    retainer=retainer.cut(box(-67.5,32.5,157.5,9.6,18,11)).removeSplitter()
    feature('ButtonRetainer','四键焊线支架 · 两侧敞开／双点支承',retainer,TEAL,ui)
    feature('ButtonMounts','四键定位座与压板螺柱 · 并入 P1',Part.makeCompound(button_mounts),TEAL,supports)
    loc = deck(48,18)
    knob = Part.makeCylinder(11.8,8.2,loc+normal*.45,normal).cut(
        Part.makeCylinder(5.8,5.3,loc+normal*3.55,normal))
    feature("Knob","音量旋钮 · 内凹",knob,KNOB_BLACK,ui)
    feature("Encoder","音量电位器轴 · 安装预留",Part.makeCylinder(4,7,loc-normal*6.55,normal),SILVER,hardware)
    # Existing amplifier potentiometer relocated behind the original outer knob.
    # Body dimensions are a design allowance, not a measurement or wiring pinout.
    pot_body=box(-7,6.55,-7,14,12,14)
    pot_body.Placement=A.Placement(loc,A.Rotation(Y,normal*-1)).multiply(pot_body.Placement)
    feature("VolumePot","分离音量电位器 · 14×14×12 预留（待测）",pot_body,RUBBER,hardware)

    # Rear vertical drive opens into the slot behind the handle.
    dw,dt,dh = DRIVE
    bottom = DRIVE_TOP-dh
    drive = block("DriveBlank","光驱毛坯",(-dw/2,SLOT_Y-dt/2,bottom),DRIVE,SILVER,hardware)
    hardware.removeObject(drive)
    visible.remove(drive)
    native_cut("Drive","UJ-898 · 竖装向上退碟",drive,
               box(-61,SLOT_Y-1,bottom+2,122,2,dh),SILVER,hardware)
    block("Bridge","SATA–USB 桥接转向占位 · 连接方式待核对",(-61,8,124),(10,24,24),PCB,hardware)
    rail_y=SLOT_Y-dt/2-1.05
    rail_width=dt+2.1
    bottom_rail=box(-68,rail_y,bottom-2,136,CASE_DEPTH-3-rail_y,2)
    side_rails=[box(x,rail_y,bottom,3.7,CASE_DEPTH-3-rail_y,dh) for x in (-68,64.3)]
    carrier=bottom_rail.multiFuse(side_rails).removeSplitter()
    feature("DriveCarrier","光驱底托和两侧导轨",carrier,TEAL,supports)
    # Upper edge follows the rear roof's 3 mm normal-offset inner plane.
    def inner_roof(y):
        return EAVE_Z+(CASE_DEPTH-y)*SHOULDER_SLOPE-ROOF_OFFSET_Z
    y0,y1=SLOT_Y-2.5,SLOT_Y+2.5
    guide=prism_yz([(y0,DRIVE_TOP),(y1,DRIVE_TOP),(y1,inner_roof(y1)),(y0,inner_roof(y0))],-63,126)
    guide=guide.cut(box(-62,SLOT_Y-1.6,DRIVE_TOP-.5,124,3.2,20))
    feature("SlotGuide","后斜面进碟导向框",guide,TEAL,supports)
    feature("DisplayPCB","SH1106 PCB · 35.4×33.5×1.2／四孔与底部缺口",oled_pcb,PCB,hardware)
    header=feature("DisplayHeader","OLED 弯针接头预留 · 图纸深度11.3／2.54节距",oled_header,RUBBER,hardware)
    header.addProperty('App::PropertyFloatList','PinCentersX').PinCentersX=[-3.81,-1.27,1.27,3.81]
    header.addProperty('App::PropertyStringList','PinLabels').PinLabels=['VCC','GND','SCL','SDA']
    feature('DisplayRetainer','OLED 可拆压框 · 四点承压／两侧锁紧',oled_frame,TEAL,ui)
    left=feature('DisplayMountLeft','OLED 左侧定位柱与压框螺柱',oled_left,TEAL,supports)
    left.Placement=display_pose.multiply(left.Placement)
    right=mirrored('DisplayMountRight','OLED 右侧支柱 · 原生镜像',left,TEAL,supports)
    doc.recompute()
    # This carrier already has world coordinates; it is not transformed below.
    feature('DisplayCarrier','OLED 四孔定位座 · 孔距30.4×28.5／外侧压框螺柱',
            Part.makeCompound([left.Shape,right.Shape]),TEAL,supports)

    # Amp stays horizontal; MCU sits in front of the raised drive.
    # DAC stands on the left side. Only PCB sizes have documentary evidence.
    lower=box(-51,5,120,102,54,2)
    feet=[box(x,yy,120.5,3,3,.5) for x in (-36,33) for yy in (5,57)]
    bridge_shelf=box(-61.5,6,120,25.5,26.5,2)
    bridge_pads=[cylinder(1.5,2,(x,y,122),Z) for x in (-59,-53) for y in (10,30)]
    feature("AmpShelf","功放与桥接器托板 · 支撑位置待测",
            lower.multiFuse(feet+[bridge_shelf]+bridge_pads).removeSplitter(),TEAL,supports)
    feature("ElectronicsSled","光驱上部前方主控托板",box(-34,32.5,147,68,29,1),TEAL,supports)
    for key,label,x,y,z,w,d,h in [
        ("Amp","TPA3118D2 · PCB 标称 66×53",-33,6,123,66,53,15),
        ("MCU","ESP32-S3 N16R8 · PCB 63.39×27.94",-31.695,33.56,148.7,63.39,27.94,7)]:
        block(key,label,(x,y,z),(w,d,1.6),PCB,hardware)
        block(key+"Chip",label+" · 全板元件高度预留（未测）",(x,y,z+1.6),(w,d,h),
              SILVER if key=="MCU" else RUBBER,hardware)
        post_base=122 if key=="Amp" else 148
        posts=[cylinder(1.5,z-post_base,(xx,yy,post_base),Z)
               for xx in (x+2,x+w-2) for yy in (y+2,y+d-2)]
        feature(key+"Pads",label+" · 支撑示意（非安装孔位）",Part.makeCompound(posts),TEAL,supports)
    block("DAC","PCM5102 · 侧置 PCB 标称 31×17",(-67,33,127),(1.6,17,31),PCB,hardware)
    block("DACChip","PCM5102 · 元件高度 7 mm 预留",(-65.4,33,127),(7,17,31),RUBBER,hardware)
    posts=[cylinder(1.5,1,(-68,yy,zz),X) for yy in (35,48) for zz in (129,156)]
    feature("DACPads","PCM5102 · 侧壁支撑示意（非安装孔位）",Part.makeCompound(posts),TEAL,supports)
    bx,by,_=BATTERY
    block("Battery","5600 mAh 平排电池包 · 商品标称 112×70×20",(-bx/2,6,8),BATTERY,BLUE,hardware)
    # A centered open-ended tray leaves 1 mm at each side of the pack.
    # Lead routing and final retention require the physical pack; no invented holes.
    cradle=box(-bx/2-3,6,6,bx+6,by,2)
    cradle=cradle.multiFuse([box(x,6,8,2,by,12) for x in (-bx/2-3,bx/2+1)])
    feature("BatteryCradle","底部平排电池托盘 · 线材与固定方式待实测",cradle.removeSplitter(),TEAL,supports)

    # Move the complete display stack together, including the native PCB boxes.
    for name in ('Window','StatusArt','DisplayPCB','DisplayHeader','DisplayRetainer'):
        obj=doc.getObject(name)
        obj.Placement=display_pose.multiply(obj.Placement)

    doc.recompute()
    # Three connected PLA solids. Construction objects remain editable and hidden.
    construction=group("Construction", "00 · 隐藏构造源（非独立打印件）")
    def consolidate(key,label,names,extra,color,parent):
        members=[doc.getObject(n) for n in names]
        shape=members[0].Shape.copy().multiFuse([o.Shape for o in members[1:]]+extra).removeSplitter()
        for obj in members:
            for g in (shell,ui,supports,hardware):
                if obj in g.Group:g.removeObject(obj)
            construction.addObject(obj)
            if obj in visible:visible.remove(obj)
            obj.Visibility=False
        result=feature(key,label,shape,color,parent)
        result.addProperty("App::PropertyStringList","ConstructionObjects")
        result.ConstructionObjects=names
        return result

    # Four rear-access wells hold short screws against blind front-cover posts.
    # Upper wells clear the electronics from above; lower wells flank the battery.
    front_posts=[];rear_bosses=[];core_tabs=[];access_wells=[];post_clearances=[]
    for sign in (-1,1):
        for x,z,start,end,radius in [(sign*67.4,18,4,11,2.8),(sign*29,179,24.5,36,3.5)]:
            post=cylinder(2.3,end-start,(x,start,z),Y).cut(cylinder(.8,5.6,(x,end-5.5,z),Y))
            front_posts.append(post)
            envelope=prism_yz(profile[:7]+[(CASE_DEPTH,3)],-WIDTH/2,WIDTH)
            well=cylinder(radius,CASE_DEPTH-end-.4,(x,end+.4,z),Y).common(envelope)
            rear_bosses.append(well)
            access_wells.extend([cylinder(1.1,3,(x,end+.3,z),Y),
                                 cylinder(2.2,CASE_DEPTH-end-3.1,(x,end+3.2,z),Y)])
            post_clearances.append(cylinder(2.55,end-start+.5,(x,start-.1,z),Y))
        for z in (27,124):
            x=sign*64
            boss=box(-68 if sign<0 else 62,7,23 if z==27 else 120.5,6,7,8 if z==27 else 7.5)
            rear_bosses.append(boss.cut(cylinder(1.0,8,(x,6.5,z),Y)))
            tab=box(-67 if sign<0 else 60,5,z-4,7,2,8)
            if z==27:tab=tab.fuse(box(-67 if sign<0 else 60,5,31,7,2,3))
            tab=tab.cut(cylinder(1.4,3,(x,4.5,z),Y)).cut(
                Part.makeCone(2.4,1.4,1,V(x,5,z),Y))
            core_tabs.append(tab)
    def source_part(name,shape):
        obj=raw(name,shape);construction.addObject(obj);obj.Visibility=False
        return name
    core_tab_names=[source_part('CarrierTab'+str(i),shape) for i,shape in enumerate(core_tabs)]
    front_post_name=source_part('FrontFastenerPosts',Part.makeCompound(front_posts))
    rear_fastener_cuts=source_part('RearFastenerCuts',Part.makeCompound(access_wells+post_clearances))
    column_shapes=[box(x,y,121.5,2,3,25.7) for x in (-51,49) for y in (37,55)]
    column_shapes += [box(x,y,145,17,3,2.5) for x in (-51,34) for y in (37,55)]
    column_names=[source_part('MCUColumn'+str(i),shape) for i,shape in enumerate(column_shapes)]
    oled_pilots.Placement=display_pose.multiply(oled_pilots.Placement)
    display_pilots=source_part('DisplayMountPilots',oled_pilots)
    oled_pocket.Placement=display_pose.multiply(oled_pocket.Placement)
    display_pocket=source_part('DisplayPocket',oled_pocket)
    for obj in (left,right):
        supports.removeObject(obj);construction.addObject(obj)
        visible.remove(obj);obj.Visibility=False
    # The roof belongs to P2. At each side wall, one straight seam joins the
    # front shoulder's inner foot to the handle root, without a stepped heel.
    seam_profile=[(FRONT_THICKNESS,0),(HANDLE_REAR,0),(HANDLE_REAR,SHOULDER_Z),
                  (FRONT_THICKNESS,FRONT_INNER_EAVE_Z)]
    roof_region_shape=box(-WIDTH/2-1,HANDLE_REAR,0,WIDTH+2,
                          CASE_DEPTH-HANDLE_REAR+1,HANDLE_TOP+1)
    roof_region_shape=roof_region_shape.multiFuse([
        prism_yz(seam_profile,-WIDTH/2,3),prism_yz(seam_profile,WIDTH/2-3,3)]).removeSplitter()
    roof_region=doc.getObject(source_part('RearRoofRegion',
        roof_region_shape))
    front_cowl=doc.addObject('Part::Cut','FrontCowl')
    front_cowl.Label='前壳折面与提手 · 后斜面已分离'
    front_cowl.Base,front_cowl.Tool=doc.Cowl,roof_region
    rear_roof=doc.addObject('Part::Common','RearRoof')
    rear_roof.Label='后斜面／碟口／侧缘直线交接 · 并入 P2'
    rear_roof.Base,rear_roof.Tool=doc.Cowl,roof_region
    shell.removeObject(doc.Cowl)
    construction.addObject(doc.Cowl)
    visible.remove(doc.Cowl)
    doc.Cowl.Visibility=False
    doc.recompute()
    front=consolidate("FrontShell","P1 · 一体前壳／提手／护网",
                      ['FrontCowl','FrontBezel','FrontGrille','ButtonMounts',front_post_name],[],ORANGE,shell)
    front.Shape=front.Shape.cut(doc.getObject(display_pocket).Shape).fuse(doc.DisplayCarrier.Shape).cut(
        doc.getObject(display_pilots).Shape).removeSplitter()
    front.ConstructionObjects=list(front.ConstructionObjects)+['DisplayCarrier']
    supports.removeObject(doc.DisplayCarrier);construction.addObject(doc.DisplayCarrier)
    visible.remove(doc.DisplayCarrier);doc.DisplayCarrier.Visibility=False
    core=consolidate("SpeakerCarrier","P3 · 双声腔／前障板／功放桥接托板",
                     ['LChamber','RChamber','LDriverFrame','RDriverFrame','FrontBaffle','AmpShelf','AmpPads',
                      'ElectronicsSled','MCUPads']+core_tab_names+column_names,
                     [],TEAL,supports)
    rear=consolidate("RearShell","P2 · 一体后壳／左右导音孔及饰片",
                     ['RearRoof','SlotGuide','LPanel','RPanel','Back','Base','BatteryCradle','DriveCarrier','DACPads','LPort','RPort'],rear_bosses,BLACK,shell)
    rear.Shape=rear.Shape.cut(doc.getObject(rear_fastener_cuts).Shape).removeSplitter()
    # Strap slots are outside the 112 mm pack. Straps are removed before sliding the pack out.
    strap_slots=[box(x,y,2.5,3,8,18) for x in (-61,58) for y in (24,44)]
    rear.Shape=rear.Shape.cut(Part.makeCompound(strap_slots)).removeSplitter()
    for obj in (front,rear,core):
        if len(obj.Shape.Solids)!=1:
            raise RuntimeError(f"{obj.Name}: expected one connected solid, got {len(obj.Shape.Solids)}")


    disc=raw("DiscReference",cylinder(60,1.2,(0,SLOT_Y-.6,180),Y).cut(
        cylinder(7.5,2,(0,SLOT_Y-1,180),Y)))
    disc.Label="参考 · 提手后竖直退碟（默认隐藏）"
    disc.ViewObject.ShapeColor=SILVER
    disc.ViewObject.DisplayMode="Shaded"
    disc.Visibility=False

    doc.recompute()
    for o in visible:
        o.Visibility = True
        if o.Shape.isNull() or not o.Shape.isValid() or not o.Shape.Solids:
            raise RuntimeError("Invalid solid: " + o.Name)
    # Let the newly created view initialize before assigning the saved camera.
    G.updateGui()
    loop = QtCore.QEventLoop()
    QtCore.QTimer.singleShot(1200, loop.quit)
    loop.exec_()
    G.activeDocument().activeView().setCameraOrientation(A.Rotation(Z,21).multiply(
        A.Rotation(X,76)).Q)
    G.activeDocument().activeView().fitAll()
    G.updateGui()
    loop = QtCore.QEventLoop()
    QtCore.QTimer.singleShot(1200, loop.quit)
    loop.exec_()
    doc.recompute()
    doc.saveAs(str(folder/"Discora.FCStd"))
    return doc, visible


target = os.environ.get("DISCORA_CAD_OUTPUT") or QtWidgets.QFileDialog.getExistingDirectory(
    None, "选择 Discora 模型输出目录")
if target:
    build(Path(target))
