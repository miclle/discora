"""Build the editable Discora V4 top-loading concept in FreeCAD. Units: mm."""
import os
from pathlib import Path

import FreeCAD as A
import FreeCADGui as G
import Part
import Sketcher
from PySide import QtCore, QtWidgets

V = A.Vector
X, Y, Z = V(1, 0, 0), V(0, 1, 0), V(0, 0, 1)
TEAL, BLACK, RUBBER = (0.025, 0.75, 0.72), (0.145, 0.155, 0.17), (0.07, 0.08, 0.09)
GLASS, PIXEL = (0.045, 0.085, 0.10), (0.85, 0.97, 1.0)
WHITE, SILVER, PCB, BLUE = (0.94, 0.95, 0.94), (0.70, 0.73, 0.75), (0.14, 0.40, 0.32), (0.12, 0.33, 0.62)
# The drive face is parallel to XZ and the disc moves vertically behind the handle.
WIDTH = 142.0
DRIVE = (128.0, 9.5, 129.0)
# User-supplied total envelope, oriented upright: depth, width, height.
# Frontmost diaphragm to rearmost magnet; mounting plane remains unmeasured.
SPEAKER = (42.0, 45.0, 80.0)
CASE_DEPTH = 78.0
# Two front-facing drivers share one circular grille, but separate rear cavities.
SPEAKER_CENTER_X, SPEAKER_CENTER_Z = 26.0, 76.0
# Align the side-view vertical port axis with the 38..43 mm handle mid-plane.
PORT_CENTER_Y, PORT_CENTER_Z = (38.0 + 43.0) / 2, 80.0
FRONT_GRILLE_RADIUS = 65.0
# Supplier image: selected flat 5600 mAh pack, excluding leads/connectors.
BATTERY = (112.0, 70.0, 20.0)
SLOT_Y = 65.75
DRIVE_TOP = 161.0
# Display mechanical envelope remains provisional; retain the original UI layout.
DISPLAY_WINDOW = (36.0, 20.0)
DISPLAY_DECK_Y = 18.0
DISPLAY_PCB = (38.0, 1.6, 30.0)


def build(folder):
    doc = A.newDocument("DiscoraV4Topload")
    doc.Label = "Discora V4 · 三件主要 PLA 结构"
    visible = []

    def group(name, label):
        obj = doc.addObject("App::DocumentObjectGroup", name)
        obj.Label = label
        return obj

    shell = group("Shell", "01 · PLA 外壳")
    ui = group("Controls", "02 · 状态屏和操控件")
    supports = group("Carrier", "03 · PLA 内部支架")
    hardware = group("Hardware", "04 · 硬件占位（待实测）")

    def finish(obj, name, color, parent):
        obj.Label = name
        parent.addObject(obj)
        obj.ViewObject.ShapeColor = color
        obj.ViewObject.DisplayMode = "Shaded"
        visible.append(obj)
        return obj

    def feature(key, label, shape, color, parent):
        obj = doc.addObject("Part::Feature", key)
        obj.Shape = shape
        return finish(obj, label, color, parent)

    def mirrored(key, label, source, color, parent):
        obj = doc.addObject("Part::Mirroring", key)
        obj.Source = source
        obj.Base, obj.Normal = V(0,0,0), X
        return finish(obj, label, color, parent)

    def prism_yz(points, x, width):
        pts = [V(x, y, z) for y, z in points]
        return Part.Face(Part.makePolygon(pts + pts[:1])).extrude(X * width)

    def cylinder(radius, height, origin, axis):
        return Part.makeCylinder(radius, height, V(*origin), axis)

    def box(x, y, z, dx, dy, dz):
        return Part.makeBox(dx, dy, dz, V(x, y, z))

    def block(key, label, origin, dims, color, parent):
        obj = doc.addObject("Part::Box", key)
        obj.Length, obj.Width, obj.Height = dims
        obj.Placement = A.Placement(V(*origin), A.Rotation())
        return finish(obj, label, color, parent)

    def obround(origin, along, across, normal, length, width, thickness):
        c = V(*origin)
        r = width / 2
        a, b = c - along * (length / 2 - r), c + along * (length / 2 - r)
        edges = [Part.makeLine(a + across*r, b + across*r),
                 Part.Arc(b + across*r, b + along*r, b - across*r).toShape(),
                 Part.makeLine(b - across*r, a - across*r),
                 Part.Arc(a - across*r, a - along*r, a + across*r).toShape()]
        return Part.Face(Part.Wire(edges)).extrude(normal * thickness)

    def display_rect(width, height, radius, y, depth):
        z = 0.0
        rect = box(-width/2+radius,y,z-height/2,width-2*radius,depth,height)
        rect = rect.fuse(box(-width/2,y,z-height/2+radius,width,depth,height-2*radius))
        corners = [cylinder(radius,depth,(x,y,zz),Y)
                   for x in (-width/2+radius,width/2-radius)
                   for zz in (z-height/2+radius,z+height/2-radius)]
        return rect.multiFuse(corners).removeSplitter()

    def side_capsule(x, y, z, length, width, depth):
        return obround((x, y, z), Z, Y, X, length, width, depth)

    def native_cut(key, label, base, tool, color, parent):
        cutter = doc.addObject("Part::Feature", key + "Tool")
        cutter.Shape = tool
        cutter.Label = label + " · 刀体"
        obj = doc.addObject("Part::Cut", key)
        obj.Base, obj.Tool = base, cutter
        base.Visibility = cutter.Visibility = False
        return finish(obj, label, color, parent)

    def raw(key, shape):
        obj = doc.addObject("Part::Feature", key)
        obj.Shape = shape
        return obj

    # An editable sketch drives the continuous front, roof and handle extrusion.
    profile = [(0,3),(0,150),(38,177),(38,202),(43,202),(43,177),(CASE_DEPTH,165),
               (CASE_DEPTH-3,163.5),(41.5,174),(39,174),(3,148.5),(3,3)]
    section = doc.addObject("Sketcher::SketchObject", "FoldSection")
    section.Label = "壳体 YZ 截面 · 可编辑"
    section.Placement = A.Placement(V(-WIDTH/2,0,0), A.Rotation(V(1,1,1),120))
    for a,b in zip(profile, profile[1:] + profile[:1]):
        section.addGeometry(Part.LineSegment(V(*a,0),V(*b,0)),False)
    skin = doc.addObject("Part::Extrusion","FoldedSkin")
    skin.Base, skin.Dir, skin.Solid = section, X*WIDTH, True
    section.Visibility = False
    # Round top outer corners on the flange; preserve the crisp shoulder folds.
    doc.recompute()
    rounded = []
    for i, edge in enumerate(skin.Shape.Edges, 1):
        c = edge.CenterOfMass
        at_end = abs(abs(c.x)-WIDTH/2) < .01
        if at_end and abs(c.z-202) < .01:
            rounded.append((i, 4.0, 4.0))
        elif at_end and abs(c.y) < .01 and edge.Length > 140:
            rounded.append((i, 1.6, 1.6))
    fil = doc.addObject("Part::Fillet","CowlEdges")
    fil.Base, fil.Edges = skin, rounded
    skin.Visibility = False
    skin = fil
    normal = V(0,-27,38)
    normal.normalize()
    def deck(x,y):
        return V(x,y,150+27*y/38)
    # Local screen X is horizontal, +Z runs up the slope, +Y points into the case.
    display_pose=A.Placement(deck(0,DISPLAY_DECK_Y),A.Rotation(Y,normal*-1))
    screen_cut=display_rect(*DISPLAY_WINDOW,3,-3,9)
    screen_cut.Placement=display_pose.multiply(screen_cut.Placement)
    holes = [obround((0,36,189.5), X,Z,Y,90,16,10),
             screen_cut,
             cylinder(FRONT_GRILLE_RADIUS,9,(0,-3,SPEAKER_CENTER_Z),Y),
             obround((0,SLOT_Y,145),X,Y,Z,124,3.2,40)]
    # Keep symmetric openings in a separate editable stage. Only the two
    # existing control cutouts are exempt from the shell's mirror constraint.
    common_tool = raw("SymmetricCowlTool",Part.makeCompound(holes))
    common_tool.Label = "居中开孔 · 提手／显示窗／格栅／碟口"
    symmetric_cowl = doc.addObject("Part::Cut","SymmetricCowl")
    symmetric_cowl.Label = "对称壳体 · 含提手及居中开孔"
    symmetric_cowl.Base, symmetric_cowl.Tool = skin, common_tool
    skin.Visibility = common_tool.Visibility = False
    controls = [Part.makeCylinder(r,12,deck(x,y)-normal*7,normal)
                for x,y,r in [(-49,18,11.25),(48,18,4.4)]]
    native_cut("Cowl","前壳 · 对称主体＋原操控开孔",symmetric_cowl,
               Part.makeCompound(controls),TEAL,shell)

    # Side openings: recessed capsule inserts with open peripheral air passages.
    panel_profile = [(3,3),(CASE_DEPTH-3,3),(CASE_DEPTH-3,163.5),(41.5,174),(39,174),(3,148.5)]
    cy, cz = PORT_CENTER_Y, PORT_CENTER_Z
    x = -WIDTH/2
    base = raw("LPanelBlank",prism_yz(panel_profile,x,3))
    left_panel = native_cut("LPanel","左侧壳 · 镜像源",base,
                            side_capsule(x-1,cy,cz,74,29,5),BLACK,shell)
    mirrored("RPanel","右侧壳 · 关联镜像",left_panel,BLACK,shell)

    # Build the left port and cavity, then mirror them exactly for the right.
    left=-WIDTH/2
    ring=side_capsule(left,cy,cz,73.4,28.4,2.6).cut(side_capsule(left-1,cy,cz,67,22,5))
    tube=side_capsule(left+2,cy,cz,67,22,10).cut(side_capsule(left+1,cy,cz,63,18,12))
    inset=side_capsule(left+1.5,cy,cz,56,12,1.5)
    bridge=box(left+2,cy-11,cz-1,1,22,2)
    port=ring.multiFuse([tube,inset,bridge]).removeSplitter()
    # Compact symmetric cavities retain the complete driver envelopes.
    outer=box(left+6,3,31.5,WIDTH/2-6,52,89)
    inner=box(left+8.5,2,34,WIDTH/2-10,50.5,84)
    cavity=outer.cut(inner).cut(side_capsule(left-1,cy,cz,67.6,22.6,13.2)).removeSplitter()
    left_port = feature("LPort","左侧 · 胶囊导音孔与内凹饰片",port,BLACK,shell)
    mirrored("RPort","右侧 · 导音孔及饰片关联镜像",left_port,BLACK,shell)
    left_chamber = feature("LChamber","左声道 · 后腔及侧向通道（未调谐）",cavity,TEAL,supports)
    mirrored("RChamber","右声道 · 后腔关联镜像（未调谐）",left_chamber,TEAL,supports)

    # Front grille, baffle and two rectangular driver envelopes.
    zc=SPEAKER_CENTER_Z
    radius=FRONT_GRILLE_RADIUS
    bezel=cylinder(radius+.25,2.85,(0,0,zc),Y).cut(cylinder(radius-1.9,4,(0,-.1,zc),Y))
    feature("FrontBezel","中央圆形格栅压圈",bezel,RUBBER,shell)
    grille=cylinder(radius-1.8,2.0,(0,0,zc),Y)
    vents=[]
    grid_extent = int(radius / 2.9) + 1
    for row in range(-grid_extent,grid_extent+1):
        dz=row*2.9
        for col in range(-grid_extent,grid_extent+1):
            dx=(col+.5*(row%2))*2.9
            if dx*dx+dz*dz<(radius-3.5)**2:
                vents.append(cylinder(.94,3,(dx,0,zc+dz),Y))
    feature("FrontGrille","中央双喇叭 · 通孔圆形护网",grille.cut(Part.makeCompound(vents)),TEAL,shell)
    depth,width,height=SPEAKER
    apertures=[]
    for right in [False,True]:
        prefix,label=("R","右") if right else ("L","左")
        cx=SPEAKER_CENTER_X if right else -SPEAKER_CENTER_X
        sx,sz=cx-width/2,zc-height/2
        if not right:
            left_driver=block("LDriver","左声道 · 80×45×42 喇叭总包络",(sx,6,sz),(width,depth,height),RUBBER,hardware)
            frame=box(sx-2,3,sz-2,width+4,depth+5,height+4).cut(
                box(sx-.2,2.5,sz-.2,width+.4,depth+6,height+.4))
            left_frame=feature("LDriverFrame","左喇叭预留框 · 安装面与孔位待测",frame,TEAL,supports)
        else:
            mirrored("RDriver","右声道 · 喇叭包络关联镜像",left_driver,RUBBER,hardware)
            mirrored("RDriverFrame","右喇叭预留框 · 关联镜像",left_frame,TEAL,supports)
        apertures.append(box(sx-.2,2.5,sz-.2,width+.4,3,height+.4))
    baffle=box(-65,3,31.5,130,2,89).cut(Part.makeCompound(apertures))
    feature("FrontBaffle","双单元前障板",baffle,RUBBER,supports)

    # Narrow side gaps leave no room for full-height rear screw pillars.
    # Lower mounts flank the battery; upper mounts sit behind the drive.
    rear=prism_yz([(CASE_DEPTH-3,3),(CASE_DEPTH,3),(CASE_DEPTH,165),
                   (CASE_DEPTH-3,163.5)],-WIDTH/2,WIDTH)
    tray=box(-WIDTH/2+3,3,3,WIDTH-6,CASE_DEPTH-6,3)
    feature("Back","后壳后壁 · 构造源",rear,BLACK,shell)
    feature("Base","后壳底板 · 构造源",tray,BLACK,shell)
    feet=[cylinder(4,3,(x,y,0),Z) for x in (-55,55) for y in (11,CASE_DEPTH-11)]
    feature("Feet","四个脚垫",Part.makeCompound(feet),RUBBER,ui)

    ww, wh = DISPLAY_WINDOW
    feature("Window","斜面状态屏 · 圆角显示窗",display_rect(ww-.4,wh-.4,2.8,.6,2),GLASS,ui)
    # Raised luminous shapes are a display-content mockup, not printable parts.
    glyphs=[]
    def segment(x,z,w,h):
        glyphs.append(box(x,.4,z,w,.15,h))
    def digit(x,z,active):
        segments={'a':(x+.5,z+7,3,.55),'g':(x+.5,z+3.5,3,.55),
                  'd':(x+.5,z,3,.55),'f':(x,z+4,.55,2.8),
                  'b':(x+3.5,z+4,.55,2.8),'e':(x,z+.7,.55,2.6),
                  'c':(x+3.5,z+.7,.55,2.6)}
        for name in active: segment(*segments[name])
    digit(-13,-2,'abcdef')
    digit(-7,-2,'abc')
    # Play icon, battery outline and volume bars.
    pts=[V(1,.4,-1),V(1,.4,5),V(5,.4,2)]
    glyphs.append(Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(Y*.15))
    bz=1
    battery=box(8,.4,bz,5,.15,3).cut(box(8.5,.3,bz+.5,4,.4,2))
    glyphs.extend([battery,box(13,.4,bz+1,.7,.15,1),box(9,.4,bz+.8,2.5,.15,1.4)])
    for i in range(8): segment(-13+i*3.4,-6,2.3,1.2)
    feature("StatusArt","显示内容示意 · 曲目 07 / 播放 / 电量 / 音量",Part.makeCompound(glyphs),PIXEL,ui)
    feature("Keycap","播放键",Part.makeCylinder(11,1.45,deck(-49,18)-normal*.5,normal),TEAL,ui)
    key_mark=Part.makeBox(1.1,5,.15,V(-.55,-2.5,0))
    key_mark.Placement=A.Placement(deck(-49,18)+normal*.95,A.Rotation(Z,normal)).multiply(key_mark.Placement)
    feature("KeyLight","播放键 · 指示灯",key_mark,WHITE,ui)
    loc = deck(48,18)
    knob = Part.makeCylinder(11.8,8.2,loc+normal*.45,normal).cut(
        Part.makeCylinder(5.8,5.3,loc+normal*3.55,normal))
    feature("Knob","音量旋钮 · 内凹",knob,WHITE,ui)
    feature("Encoder","音量电位器轴 · 安装预留",Part.makeCylinder(4,5,loc-normal*4.55,normal),SILVER,hardware)
    # Existing amplifier potentiometer relocated behind the original outer knob.
    # Body dimensions are a design allowance, not a measurement or wiring pinout.
    pot_body=box(-7,4.55,-7,14,12,14)
    pot_body.Placement=A.Placement(loc,A.Rotation(Y,normal*-1)).multiply(pot_body.Placement)
    feature("VolumePot","分离音量电位器 · 14×14×12 预留（待测）",pot_body,RUBBER,hardware)

    # Rear vertical drive opens into the slot behind the handle.
    dw,dt,dh = DRIVE
    bottom = DRIVE_TOP-dh
    drive = block("DriveBlank","光驱毛坯",(-dw/2,SLOT_Y-dt/2,bottom),DRIVE,SILVER,hardware)
    hardware.removeObject(drive)
    visible.remove(drive)
    native_cut("Drive","UJ-898 · 竖装向上退碟",drive,
               box(-61,SLOT_Y-1,bottom+2,122,2,dh),SILVER,hardware)
    block("Bridge","SATA–USB 桥接转向占位 · 连接方式待核对",(-61,6,124),(10,24,24),PCB,hardware)
    rail_y=SLOT_Y-dt/2-1.05
    rail_width=dt+2.1
    bottom_rail=box(-68,rail_y,bottom-2,136,CASE_DEPTH-3-rail_y,2)
    side_rails=[box(x,rail_y,bottom,3.7,CASE_DEPTH-3-rail_y,dh) for x in (-68,64.3)]
    carrier=bottom_rail.multiFuse(side_rails).removeSplitter()
    feature("DriveCarrier","光驱底托和两侧导轨",carrier,TEAL,supports)
    # Upper edge follows the existing rear roof's inner plane.
    def inner_roof(y):
        return 174-(y-41.5)*10.5/(CASE_DEPTH-44.5)
    y0,y1=SLOT_Y-2.5,SLOT_Y+2.5
    guide=prism_yz([(y0,DRIVE_TOP),(y1,DRIVE_TOP),(y1,inner_roof(y1)),(y0,inner_roof(y0))],-63,126)
    guide=guide.cut(box(-62,SLOT_Y-1.6,DRIVE_TOP-.5,124,3.2,20))
    feature("SlotGuide","后斜面进碟导向框",guide,TEAL,supports)
    pw, pt, ph = DISPLAY_PCB
    block("DisplayPCB","小型单色状态屏 PCB · 预估占位",(-pw/2,7.4,-ph/2),DISPLAY_PCB,PCB,hardware)
    block("DisplayHeader","状态屏接头 · 预估占位",(-5,9,-14),(10,4,4),RUBBER,hardware)
    frame=box(-pw/2-3,3.3,-ph/2-3,pw+6,5.7,ph+6).cut(
        box(-pw/2-.3,2.5,-ph/2-.3,pw+.6,7,ph+.6))
    seat=box(-pw/2-3,9,-ph/2-3,pw+6,2,ph+6).cut(
        box(-pw/2+2,8.5,-ph/2+2,pw-4,3,ph-4))
    frame=frame.fuse(seat).cut(box(-5.3,8.8,-14.3,10.6,4.5,4.6))
    feature("DisplayCarrier","小状态屏安装座 · 待选型细化",frame.removeSplitter(),TEAL,supports)

    # Amp stays horizontal; MCU sits in front of the raised drive.
    # DAC stands on the left side. Only PCB sizes have documentary evidence.
    lower=box(-51,3,120,102,54,2)
    feet=[box(x,yy,120.5,3,3,.5) for x in (-36,33) for yy in (3,55)]
    bridge_shelf=box(-61.5,4,120,25.5,26.5,2)
    bridge_pads=[cylinder(1.5,2,(x,y,122),Z) for x in (-59,-53) for y in (8,28)]
    feature("AmpShelf","功放与桥接器托板 · 支撑位置待测",
            lower.multiFuse(feet+[bridge_shelf]+bridge_pads).removeSplitter(),TEAL,supports)
    feature("ElectronicsSled","光驱上部前方主控托板",box(-34,30.5,147,68,29,1),TEAL,supports)
    for key,label,x,y,z,w,d,h in [
        ("Amp","TPA3118D2 · PCB 标称 66×53",-33,4,123,66,53,15),
        ("MCU","ESP32-S3 N16R8 · PCB 63.39×27.94",-31.695,31.56,148.7,63.39,27.94,7)]:
        block(key,label,(x,y,z),(w,d,1.6),PCB,hardware)
        block(key+"Chip",label+" · 全板元件高度预留（未测）",(x,y,z+1.6),(w,d,h),
              SILVER if key=="MCU" else RUBBER,hardware)
        post_base=122 if key=="Amp" else 148
        posts=[cylinder(1.5,z-post_base,(xx,yy,post_base),Z)
               for xx in (x+2,x+w-2) for yy in (y+2,y+d-2)]
        feature(key+"Pads",label+" · 支撑示意（非安装孔位）",Part.makeCompound(posts),TEAL,supports)
    block("DAC","PCM5102 · 侧置 PCB 标称 31×17",(-67,31,127),(1.6,17,31),PCB,hardware)
    block("DACChip","PCM5102 · 元件高度 7 mm 预留",(-65.4,31,127),(7,17,31),RUBBER,hardware)
    posts=[cylinder(1.5,1,(-68,yy,zz),X) for yy in (33,46) for zz in (129,156)]
    feature("DACPads","PCM5102 · 侧壁支撑示意（非安装孔位）",Part.makeCompound(posts),TEAL,supports)
    bx,by,_=BATTERY
    block("Battery","5600 mAh 平排电池包 · 商品标称 112×70×20",(-bx/2,4,8),BATTERY,BLUE,hardware)
    # A centered open-ended tray leaves 1 mm at each side of the pack.
    # Lead routing and final retention require the physical pack; no invented holes.
    cradle=box(-bx/2-3,4,6,bx+6,by,2)
    cradle=cradle.multiFuse([box(x,4,8,2,by,12) for x in (-bx/2-3,bx/2+1)])
    feature("BatteryCradle","底部平排电池托盘 · 线材与固定方式待实测",cradle.removeSplitter(),TEAL,supports)

    # Move the complete display stack together, including the native PCB boxes.
    for name in ('Window','StatusArt','DisplayPCB','DisplayHeader','DisplayCarrier'):
        obj=doc.getObject(name)
        obj.Placement=display_pose.multiply(obj.Placement)

    doc.recompute()
    # Three connected PLA solids. Construction objects remain editable and hidden.
    construction=group("Construction", "00 · 隐藏构造源（非独立打印件）")
    def consolidate(key,label,names,extra,color,parent):
        members=[doc.getObject(n) for n in names]
        shape=members[0].Shape.copy().multiFuse([o.Shape for o in members[1:]]+extra).removeSplitter()
        for obj in members:
            for g in (shell,ui,supports,hardware):
                if obj in g.Group:g.removeObject(obj)
            construction.addObject(obj)
            if obj in visible:visible.remove(obj)
            obj.Visibility=False
        result=feature(key,label,shape,color,parent)
        result.addProperty("App::PropertyStringList","ConstructionObjects")
        result.ConstructionObjects=names
        return result

    # Four front-cover screws; four separate carrier screws exposed after cover removal.
    front_holes=[];rear_bosses=[];core_tabs=[]
    for sign in (-1,1):
        for z in (18,140):
            x=sign*65
            boss=box(-68 if sign<0 else 62,3.4,z-4,6,7.6,8)
            boss=boss.cut(cylinder(1.0,8,(x,3,z),Y))
            rear_bosses.append(boss)
            front_holes.extend([cylinder(1.4,4,(x,-.5,z),Y),
                                Part.makeCone(2.6,1.4,1.2,V(x,0,z),Y)])
        for z in (27,124):
            x=sign*64
            boss=box(-68 if sign<0 else 62,5,23 if z==27 else 120.5,6,7,8 if z==27 else 7.5)
            rear_bosses.append(boss.cut(cylinder(1.0,8,(x,4.5,z),Y)))
            tab=box(-67 if sign<0 else 60,3,z-4,7,2,8)
            if z==27:tab=tab.fuse(box(-67 if sign<0 else 60,3,31,7,2,3))
            tab=tab.cut(cylinder(1.4,3,(x,2.5,z),Y)).cut(
                Part.makeCone(2.4,1.4,1,V(x,3,z),Y))
            core_tabs.append(tab)
    def source_part(name,shape):
        obj=raw(name,shape);construction.addObject(obj);obj.Visibility=False
        return name
    core_tab_names=[source_part('CarrierTab'+str(i),shape) for i,shape in enumerate(core_tabs)]
    column_shapes=[box(x,y,121.5,2,3,25.7) for x in (-51,49) for y in (35,53)]
    column_shapes += [box(x,y,145,17,3,2.5) for x in (-51,34) for y in (35,53)]
    column_names=[source_part('MCUColumn'+str(i),shape) for i,shape in enumerate(column_shapes)]
    bridge_shape=box(-22,2,-18,44,1.5,36).cut(box(-18.3,1.5,-10.3,36.6,3,20.6))
    bridge_shape.Placement=display_pose.multiply(bridge_shape.Placement)
    display_bridge=source_part('DisplayShellBridge',bridge_shape)
    front=consolidate("FrontShell","P1 · 一体前壳／提手／护网",
                      ['Cowl','FrontBezel','FrontGrille','SlotGuide','DisplayCarrier',display_bridge],[],TEAL,shell)
    front.Shape=front.Shape.cut(Part.makeCompound(front_holes)).removeSplitter()
    core=consolidate("SpeakerCarrier","P3 · 双声腔／前障板／功放桥接托板",
                     ['LChamber','RChamber','LDriverFrame','RDriverFrame','FrontBaffle','AmpShelf','AmpPads',
                      'ElectronicsSled','MCUPads']+core_tab_names+column_names,
                     [],TEAL,supports)
    rear=consolidate("RearShell","P2 · 左右侧壁／后壁／底板／电池托盘",
                     ['LPanel','RPanel','Back','Base','BatteryCradle','DriveCarrier','DACPads'],rear_bosses,BLACK,shell)
    # Strap slots are outside the 112 mm pack. Straps are removed before sliding the pack out.
    strap_slots=[box(x,y,2.5,3,8,18) for x in (-61,58) for y in (22,42)]
    rear.Shape=rear.Shape.cut(Part.makeCompound(strap_slots)).removeSplitter()
    # The side ports remain two removable inserts: they obstruct front insertion if fixed.
    # Add flush tabs and accessible M2 countersunk clearance holes; nominal pilot bores.
    for sign in (-1,1):
        port=doc.getObject('LPort' if sign<0 else 'RPort')
        shape=port.Shape.copy()
        for z in (39,117):
            tab=box(-71 if sign<0 else 69,cy-4,z-4,2,8,8)
            # Join the tab to the capsule rim, while keeping its external surface flush.
            neck=box(-71 if sign<0 else 69,cy-2,z if z==39 else 113,2,4,8)
            shape=shape.fuse(tab).fuse(neck)
            axis=X if sign<0 else X*-1
            origin=V(sign*71,cy,z)
            shape=shape.cut(Part.makeCylinder(1.1,3,origin-axis*.1,axis))
            shape=shape.cut(Part.makeCone(2.1,1.1,1,origin,axis))
            recess=box(-71.1 if sign<0 else 68.7,cy-4.3,z-4.3,2.4,8.6,8.6)
            rear.Shape=rear.Shape.cut(recess)
            boss=box(-68.1 if sign<0 else 65.5,cy-4,z-(4 if z==39 else 3),2.6,8,8 if z==39 else 7)
            boss=boss.cut(Part.makeCylinder(.8,5,origin+axis*2,axis))
            rear.Shape=rear.Shape.fuse(boss)
        if sign<0:port.Shape=shape.removeSplitter()
    rear.Shape=rear.Shape.removeSplitter()
    # The right port is an editable mirror, so changing its Shape directly would be lost.
    doc.RPort.Source=doc.LPort
    doc.recompute()
    for obj in (front,rear,core):
        if len(obj.Shape.Solids)!=1:
            raise RuntimeError(f"{obj.Name}: expected one connected solid, got {len(obj.Shape.Solids)}")


    disc=raw("DiscReference",cylinder(60,1.2,(0,SLOT_Y-.6,180),Y).cut(
        cylinder(7.5,2,(0,SLOT_Y-1,180),Y)))
    disc.Label="参考 · 提手后竖直退碟（默认隐藏）"
    disc.ViewObject.ShapeColor=SILVER
    disc.ViewObject.DisplayMode="Shaded"
    disc.Visibility=False

    doc.recompute()
    for o in visible:
        o.Visibility = True
        if o.Shape.isNull() or not o.Shape.isValid() or not o.Shape.Solids:
            raise RuntimeError("Invalid solid: " + o.Name)
    # Let the newly created view initialize before assigning the saved camera.
    G.updateGui()
    loop = QtCore.QEventLoop()
    QtCore.QTimer.singleShot(1200, loop.quit)
    loop.exec_()
    G.activeDocument().activeView().setCameraOrientation(A.Rotation(Z,21).multiply(
        A.Rotation(X,76)).Q)
    G.activeDocument().activeView().fitAll()
    G.updateGui()
    loop = QtCore.QEventLoop()
    QtCore.QTimer.singleShot(1200, loop.quit)
    loop.exec_()
    doc.recompute()
    doc.saveAs(str(folder/"Discora.FCStd"))
    return doc, visible


target = os.environ.get("DISCORA_CAD_OUTPUT") or QtWidgets.QFileDialog.getExistingDirectory(
    None, "选择 Discora 模型输出目录")
if target:
    build(Path(target))
