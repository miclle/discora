# Bounded seek-only workload: 20 rounds, one recovery per MCU boot.
CONFIG_DISCORA_AUDIO_DIAGNOSTIC=n
CONFIG_DISCORA_CDDA_PROBE=y
CONFIG_DISCORA_CDDA_SOAK=y
CONFIG_DISCORA_CDDA_SEEK_BENCH=y
CONFIG_DISCORA_CDDA_FULL_TRACK_BENCH=n
CONFIG_DISCORA_CDDA_UNDERRUN_TEST=n
CONFIG_DISCORA_CDDA_SOAK_SECONDS=60
CONFIG_DISCORA_SENSE_DATA_TIMEOUT_MS=30000
CONFIG_DISCORA_CDDA_SEEK_WAIT_MS=0
CONFIG_DISCORA_CDDA_SEEK_RECOVERY=y
CONFIG_DISCORA_CDDA_SEEK_ROUNDS=20
CONFIG_DISCORA_CDDA_SEEK_ONLY=y
