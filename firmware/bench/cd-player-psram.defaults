# Append after sdkconfig.defaults and bench/cd-player-i2s.defaults; N16R8 octal PSRAM only.
# Current verified audio wiring. GPIO7 cannot also be an eject button.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_DISCORA_CD_PLAYER_PSRAM_BUFFER=y
CONFIG_DISCORA_CD_PLAYER_AUTO_RECOVER=y
CONFIG_DISCORA_CD_PLAYER_GAIN_PERCENT=25
CONFIG_DISCORA_I2S_BCLK=15
CONFIG_DISCORA_I2S_LRCK=16
CONFIG_DISCORA_I2S_DATA=7
CONFIG_DISCORA_EJECT_BUTTON=n
CONFIG_DISCORA_TRACK_BUTTONS=n
CONFIG_DISCORA_OLED=n
