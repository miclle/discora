# UART-controlled actual CD source; boot stopped, no bench auto-run.
CONFIG_DISCORA_AUDIO_DIAGNOSTIC=n
CONFIG_DISCORA_CD_PLAYER=y
CONFIG_DISCORA_CDDA_PROBE=n
CONFIG_DISCORA_CDDA_SOAK=n
CONFIG_DISCORA_SENSE_DATA_TIMEOUT_MS=30000
CONFIG_DISCORA_CDDA_SEEK_RECOVERY=n
CONFIG_DISCORA_CD_PLAYER_I2S=y
CONFIG_DISCORA_CD_PLAYER_VERIFY=y
