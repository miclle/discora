menu "Discora bench probes"

config DISCORA_CDDA_PROBE
    bool "Run one bounded READ CD probe per MCU boot"
    depends on !DISCORA_AUDIO_DIAGNOSTIC && !DISCORA_CD_PLAYER
    default n
    help
        Experimental, read-only CD-DA probe: requires a validated audio TOC.
        Reads 1 sector, 8 sectors twice, then at most 32 batches of 8 sectors.
        A reconnect or medium-state change does not re-arm the probe.
        Leave disabled until the bridge and power path have been checked.
        No audio bytes are logged or written to flash.

config DISCORA_CDDA_SOAK
    bool "Run seek, full-track and paced-buffer tests after the short probe"
    depends on DISCORA_CDDA_PROBE
    default n
    help
        One bounded run per MCU boot. Read recovery is separately opt-in.
        Uses real CD data and a software clocked discard sink, not I2S playback.

config DISCORA_SENSE_DATA_TIMEOUT_MS
    int "Diagnostic REQUEST SENSE data-stage timeout (ms)"
    depends on DISCORA_CDDA_PROBE || DISCORA_CD_PLAYER
    range 3000 30000
    default 3000
    help
        Changes only REQUEST SENSE Bulk IN data waiting. CBW, CSW and control
        transfers keep their normal deadline. No command replay is added.

config DISCORA_CDDA_SEEK_BENCH
    bool "Include the 12-position seek experiment"
    depends on DISCORA_CDDA_SOAK
    default y
    help
        Disable to isolate full-track and paced-buffer tests after a seek fault.
        A run with this disabled does not qualify seek behavior.

config DISCORA_CDDA_SEEK_WAIT_MS
    int "Quiet wait before each seek position (ms)"
    depends on DISCORA_CDDA_SEEK_BENCH
    range 0 3000
    default 0

config DISCORA_CDDA_SEEK_ROUNDS
    int "Number of 12-position seek rounds"
    depends on DISCORA_CDDA_SEEK_BENCH
    range 1 20
    default 1
    help
        Stop at the first unrecovered error. Recovery budget is per boot,
        never per round. A 600 s soft deadline is checked between positions;
        an in-flight command completes or reaches its normal timeout first.

config DISCORA_CDDA_SEEK_ONLY
    bool "Stop the extended workload after seeks (no full track or buffer)"
    depends on DISCORA_CDDA_SEEK_BENCH
    default n

config DISCORA_CDDA_SEEK_VARY_OFFSET
    bool "Vary track-relative offsets after the first seek round"
    depends on DISCORA_CDDA_SEEK_BENCH
    default n
    help
        Add 997 sectors per round modulo the valid eight-sector start range.
        Deterministic workload expansion, not a guarantee of cache bypass.

config DISCORA_CDDA_SEEK_RECOVERY
    bool "Allow one read recovery per boot for valid sense 03/02/00"
    depends on DISCORA_CDDA_PROBE || DISCORA_CD_PLAYER
    default n
    help
        Reserve one recovery, wait 1000 ms while servicing USB, require TUR
        success, then replay the identical read once. Never replay after
        disconnect, transport fault, missing sense or medium change.
        Preserve the original failure and report recovered reads separately.

config DISCORA_CDDA_FULL_TRACK_BENCH
    bool "Include a complete first-track read from INDEX 01"
    depends on DISCORA_CDDA_SOAK && !DISCORA_CDDA_SEEK_ONLY
    default y
    help
        Disable this and seeks to hand off sequentially from the short probe
        into the paced-buffer phase, without seeking back to an earlier LBA.

config DISCORA_CDDA_UNDERRUN_TEST
    bool "Negative control: pause producer to force a clock-sink underrun"
    depends on DISCORA_CDDA_SOAK && !DISCORA_CDDA_SEEK_BENCH && !DISCORA_CDDA_FULL_TRACK_BENCH
    default n
    help
        After two seconds, pause only the producer for 1200 ms. The normal
        buffer test must fail with one genuine underrun, stop and release
        the ring. A negative-control PASS is not a streaming PASS.

config DISCORA_CDDA_SOAK_SECONDS
    int "Paced-buffer test duration in seconds"
    depends on DISCORA_CDDA_SOAK
    range 60 1800
    default 600

endmenu

menu "Discora CD player"

config DISCORA_CD_PLAYER
    bool "Enable UART-controlled CD player (boot stopped)"
    depends on !DISCORA_AUDIO_DIAGNOSTIC
    default n
    help
        Real READ CD producer with independent output/control task. Bench probes
        are disabled. Software-clock sink by default; never claim audible output.

config DISCORA_CD_PLAYER_VERIFY
    bool "Hash accepted and consumed CD PCM for single-track EOF verification"
    depends on DISCORA_CD_PLAYER
    default n
    help
        Diagnostic overhead under the queue mutex. Logs counts and SHA-256 only;
        no PCM is saved. Verifies the software queue, not audible I2S delivery.

config DISCORA_CD_PLAYER_I2S
    bool "Use I2S instead of the software-clock sink"
    depends on DISCORA_CD_PLAYER
    default n
    help
        Requires a verified DAC board and wiring. This mode is compile-tested
        until physical output and L/R channels are measured.

endmenu

menu "Discora audio diagnostic"

config DISCORA_AUDIO_DIAGNOSTIC
    bool "Run UART-controlled I2S test tones instead of the USB probe"
    default n
    help
        Standalone generated-tone diagnostic, not CD playback. Boot is stopped.
        Commands select left/right/stereo/silence and play/pause/stop/status.
        Disables the USB probe in this mode; do not mix optical bench results.

config DISCORA_I2S_BCLK
    int "BCLK output GPIO"
    depends on DISCORA_AUDIO_DIAGNOSTIC || DISCORA_CD_PLAYER_I2S
    range 1 18
    default 4

config DISCORA_I2S_LRCK
    int "LRCK/WS output GPIO"
    depends on DISCORA_AUDIO_DIAGNOSTIC || DISCORA_CD_PLAYER_I2S
    range 1 18
    default 5

config DISCORA_I2S_DATA
    int "DAC DIN output GPIO"
    depends on DISCORA_AUDIO_DIAGNOSTIC || DISCORA_CD_PLAYER_I2S
    range 1 18
    default 6

endmenu
